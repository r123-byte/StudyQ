{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/stats/script.js",
      "destination": "https://umami.is"
    },
    {
      "source": "/stats/api/send",
      "destination": "https://umami.is"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*/index.html",
      "destination": "/:path*/",
      "permanent": true
    },
    {
      "source": "/tools/",
      "destination": "/",
      "permanent": true
    }
  ]
}
